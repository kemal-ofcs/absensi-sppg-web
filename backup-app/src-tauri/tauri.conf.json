{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hybrid Starter",
  "version": "0.1.0",
  "identifier": "com.hybridstarter.app",
  "build": {
    "frontendDist": "bootstrap",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hybrid Starter",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data:; img-src 'self' blob: data: https:; connect-src 'self' https: ws:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "resources": [
      "desktop-runtime/runtime-bundle.tar",
      "desktop-runtime/runtime-config.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hybrid-starter.db"]
    }
  }
}
