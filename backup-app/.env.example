# Shared cloud database. These values are server-only.
# Use a Turso database-scoped token and rotate it if a device is lost.
# Never copy either token into a NEXT_PUBLIC_* variable.
AUTH_DATABASE_URL="libsql://your-project.turso.io"
AUTH_DATABASE_AUTH_TOKEN="replace-with-auth-db-token"
SYNC_DATABASE_URL="libsql://your-project.turso.io"
SYNC_DATABASE_AUTH_TOKEN="replace-with-sync-db-token"

# Packaged desktop stores SYNC_DATABASE_* in the OS keyring through its
# Secure cloud sync panel. These env values are for web/server development.

# Web authentication.
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Product identity.
NEXT_PUBLIC_APP_NAME="Hybrid Starter"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Development seed only. Change before production.
STARTER_ADMIN_PASSWORD="admin123"

# Optional Turso-compatible aliases.
# TURSO_DATABASE_URL="libsql://your-project.turso.io"
# TURSO_AUTH_TOKEN="replace-with-token"
