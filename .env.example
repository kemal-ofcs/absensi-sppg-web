# Web/Vercel server only. Jangan tambahkan prefix NEXT_PUBLIC pada credential.
TURSO_DATABASE_URL="libsql://database-name.turso.io"
TURSO_AUTH_TOKEN="replace-with-a-rotated-server-token"

# Hanya diperlukan untuk bootstrap satu kali melalui CLI lokal.
SPPG_SUPERADMIN_NAME="Nama Superadmin"
SPPG_SUPERADMIN_USERNAME="superadmin"
SPPG_SUPERADMIN_PASSWORD="ReplaceWithStrongPassword2026"
