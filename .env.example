# Web/Vercel server only. Jangan tambahkan prefix NEXT_PUBLIC pada credential.
# Nama lama TURSO_DATABASE_URL / TURSO_AUTH_TOKEN masih dibaca.
KOS_DATABASE_URL="libsql://database-name.turso.io"
KOS_DATABASE_AUTH_TOKEN="replace-with-a-rotated-server-token"
# `turso` (bawaan) atau `self_hosted` untuk server libSQL sendiri.
KOS_DATABASE_PROVIDER="turso"

# Desktop/Tauri: masa berlaku login offline.
# Tentukan kebijakan pelanggan dalam jam (rentang 1-720) sebelum build release.
SPPG_OFFLINE_AUTH_MAX_AGE_HOURS="REPLACE_WITH_APPROVED_HOURS"

# Membuka halaman /setup untuk membuat Superadmin pertama dari browser.
# Kosong = pintunya tertutup. Minimal 32 karakter acak, misalnya hasil
# `openssl rand -base64 32`. Hapus lagi setelah Superadmin dibuat.
KOS_SETUP_TOKEN=""

# Alternatif tanpa browser: bootstrap satu kali melalui CLI lokal
# (`bun run bootstrap:superadmin`). Nama lama SPPG_SUPERADMIN_* masih dibaca.
KOS_SUPERADMIN_NAME="Nama Superadmin"
KOS_SUPERADMIN_USERNAME="superadmin"
KOS_SUPERADMIN_EMAIL="superadmin@perusahaan.co.id"
KOS_SUPERADMIN_PHONE="081234567890"
# Minimal 12 karakter: huruf besar, huruf kecil, angka, simbol, tanpa username.
KOS_SUPERADMIN_PASSWORD="Replace-With-Strong-Password-2026!"

# Lisensi Web. Image self-hosted sudah menyalakannya sendiri (Dockerfile dan
# paket Windows). Untuk project Vercel klien SEWA, isi variabel ini di
# Environment Variables project SEBELUM build: nilainya ditanam saat build,
# jadi mengubahnya butuh redeploy. Project demo milik sendiri dibiarkan kosong.
# KOS_LICENSE_ENFORCED=1

# Jumlah reverse proxy tepercaya di depan server (nginx/Caddy). Vercel: biarkan 1.
# Menentukan entri X-Forwarded-For mana yang dianggap alamat klien.
KOS_TRUSTED_PROXY_HOPS=1
